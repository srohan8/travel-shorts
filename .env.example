# Copy this file to .env and fill in your values
# Place .env next to the Travel Shorts AI executable

# Choose your AI provider: "gemini" or "ollama"
AI_PROVIDER=ollama

# Ollama settings (if AI_PROVIDER=ollama)
# Install Ollama from https://ollama.com, then run: ollama pull gemma4:31b-cloud
OLLAMA_MODEL=gemma4:31b-cloud
OLLAMA_HOST=http://localhost:11434

# Gemini settings (if AI_PROVIDER=gemini)
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Minnal (optional — for scheduling posts)
# Get your key at https://app.minnal.io
MINNAL_API_KEY=
