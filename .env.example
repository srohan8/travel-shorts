# ── AI Provider ──────────────────────────────────────────────────────────────

# Which AI to use: gemini | ollama | openai | anthropic
AI_PROVIDER=gemini

# Gemini — get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Ollama — install from https://ollama.com, then: ollama pull gemma4:27b
OLLAMA_MODEL=gemma4:27b
OLLAMA_HOST=http://localhost:11434

# OpenAI — get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic — get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Output ────────────────────────────────────────────────────────────────────

# Target platform: shorts | reels | tiktok  (affects max duration)
OUTPUT_FORMAT=shorts

# Smart crop landscape footage to 9:16 (face + motion detection via OpenCV)
SMART_CROP=true

# Colour grade — range: -50 to +50 (sharpness: 0–100)
FILTER_BRIGHTNESS=0
FILTER_CONTRAST=0
FILTER_SATURATION=0
FILTER_SHARPNESS=0

# ── Cloud mode (leave blank / false for self-hosted) ─────────────────────────

# Set to true only when deploying the managed cloud version
CLOUD_MODE=false

# Lemon Squeezy — only needed when CLOUD_MODE=true
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# Managed Gemini key injected in cloud deployments (users never touch this)
GEMINI_API_KEY_MANAGED=

# Flask secret key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
